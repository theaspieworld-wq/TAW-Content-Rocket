modules = ["nodejs-24", "python-3.11", "postgresql-16"]

[[artifacts]]
id = "artifacts/api-server"

[[artifacts]]
id = "artifacts/mockup-sandbox"

[deployment]
router = "application"
deploymentTarget = "autoscale"

[deployment.postBuild]
args = ["sh", "-c", "pnpm store prune && rm -rf .git .local .cache artifacts/api-server/uploads artifacts/api-server/clips artifacts/api-server/brands artifacts/api-server/outros"]
env = { "CI" = "true" }

[workflows]
runButton = "Project"

[agent]
stack = "PNPM_WORKSPACE"
expertMode = true
integrations = ["stripe:1.0.0"]

[postMerge]
path = "scripts/post-merge.sh"
timeoutMs = 20000

[nix]
channel = "stable-25_05"

[userenv]

[userenv.shared]
VITE_CLERK_PUBLISHABLE_KEY = "pk_test_bmV1dHJhbC1tb25pdG9yLTcwLmNsZXJrLmFjY291bnRzLmRldiQ"
ADMIN_USER_IDS = "user_3DD6aZbe4fwHXWybCekyXF0S8d2"
ADMIN_EMAILS = "theaspieworld@gmail.com,guest@theaspieworld.com,teamtawsupport@gmail.com"
YOUTUBE_COOKIES = ""

[[ports]]
localPort = 8080
externalPort = 8080

[[ports]]
localPort = 8081
externalPort = 8081

[[ports]]
localPort = 19024
externalPort = 80

[[ports]]
localPort = 21675
externalPort = 3000
